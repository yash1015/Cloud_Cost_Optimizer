{
  "title": "FinOps Cost Optimization",
  "tags": ["finops", "aws", "cost"],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Total Monthly Waste ($)",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{
        "datasource": "cloudwatch",
        "namespace": "FinOps/CostOptimization",
        "metricName": "TotalMonthlyWaste",
        "dimensions": {"Tool": "FinOps"},
        "statistic": "Maximum",
        "period": "300"
      }],
      "options": {"colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"steps": [
          {"color": "green", "value": 0},
          {"color": "yellow", "value": 50},
          {"color": "red", "value": 100}
        ]},
        "unit": "currencyUSD"
      }}
    },
    {
      "id": 2,
      "title": "Total Findings",
      "type": "stat",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "targets": [{
        "datasource": "cloudwatch",
        "namespace": "FinOps/CostOptimization",
        "metricName": "TotalFindings",
        "dimensions": {"Tool": "FinOps"},
        "statistic": "Maximum",
        "period": "300"
      }],
      "options": {"colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"},
        "thresholds": {"steps": [
          {"color": "green", "value": 0},
          {"color": "yellow", "value": 5},
          {"color": "red", "value": 10}
        ]}
      }}
    },
    {
      "id": 3,
      "title": "Annual Projected Waste ($)",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "targets": [{
        "datasource": "cloudwatch",
        "namespace": "FinOps/CostOptimization",
        "metricName": "TotalMonthlyWaste",
        "dimensions": {"Tool": "FinOps"},
        "statistic": "Maximum",
        "period": "300"
      }],
      "options": {"colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {
        "unit": "currencyUSD",
        "mappings": [],
        "thresholds": {"steps": [{"color": "red", "value": 0}]}
      },
      "overrides": [{"matcher": {"id": "byName", "options": "Value"},
        "properties": [{"id": "custom.transform", "value": "multiply(12)"}]
      }]}
    },
    {
      "id": 4,
      "title": "Findings by Service",
      "type": "barchart",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [
        {
          "datasource": "cloudwatch",
          "namespace": "FinOps/CostOptimization",
          "metricName": "EC2Findings",
          "dimensions": {"Tool": "FinOps"},
          "statistic": "Maximum",
          "period": "300",
          "alias": "EC2"
        },
        {
          "datasource": "cloudwatch",
          "namespace": "FinOps/CostOptimization",
          "metricName": "EBSFindings",
          "dimensions": {"Tool": "FinOps"},
          "statistic": "Maximum",
          "period": "300",
          "alias": "EBS"
        },
        {
          "datasource": "cloudwatch",
          "namespace": "FinOps/CostOptimization",
          "metricName": "S3Findings",
          "dimensions": {"Tool": "FinOps"},
          "statistic": "Maximum",
          "period": "300",
          "alias": "S3"
        },
        {
          "datasource": "cloudwatch",
          "namespace": "FinOps/CostOptimization",
          "metricName": "K8sFindings",
          "dimensions": {"Tool": "FinOps"},
          "statistic": "Maximum",
          "period": "300",
          "alias": "Kubernetes"
        }
      ]
    },
    {
      "id": 5,
      "title": "Monthly Savings Opportunity Over Time",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 12, "w": 24, "h": 8},
      "targets": [{
        "datasource": "cloudwatch",
        "namespace": "FinOps/CostOptimization",
        "metricName": "TotalMonthlyWaste",
        "dimensions": {"Tool": "FinOps"},
        "statistic": "Maximum",
        "period": "300"
      }],
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "color": {"mode": "palette-classic"}}}
    }
  ],
  "refresh": "5m",
  "time": {"from": "now-24h", "to": "now"},
  "schemaVersion": 38
}
